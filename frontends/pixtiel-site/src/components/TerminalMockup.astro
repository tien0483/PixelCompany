---
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;

// TODO: update with published I4 URL when available
const installCommand = "curl -fsSL https://raw.githubusercontent.com/<org>/<repo>/main/install.sh | bash";
---

<div class={`w-full max-w-3xl mx-auto rounded-xl border border-[#30363D] bg-[#1F2428] overflow-hidden shadow-2xl ${className}`}>
	<!-- Terminal header -->
	<div class="px-4 py-3 bg-[#24292E] border-b border-[#30363D] flex items-center justify-between">
		<div class="flex items-center gap-2">
			<span class="w-3 h-3 rounded-full bg-[#FF5F56]/80 inline-block"></span>
			<span class="w-3 h-3 rounded-full bg-[#FFBD2E]/80 inline-block"></span>
			<span class="w-3 h-3 rounded-full bg-[#27C93F]/80 inline-block"></span>
		</div>
		<div class="text-xs font-mono text-[#8B949E] flex items-center gap-2">
			<svg class="w-3.5 h-3.5 text-[#6E7681]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<polyline points="4 17 10 11 4 5"></polyline>
				<line x1="12" y1="19" x2="20" y2="19"></line>
			</svg>
			<span>pixtiel-installer — bash</span>
		</div>
		<div class="w-12"></div>
	</div>

	<!-- Terminal screen content -->
	<div class="p-6 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto text-[#E6EDF3] bg-[#191D21]">
		<!-- ASCII Banner -->
		<pre class="text-[#0084FF] font-bold text-[10px] sm:text-xs leading-none select-none mb-6">
██████╗ ██╗██╗  ██╗████████╗██╗███████╗██╗     
██╔══██╗██║╚██╗██╔╝╚══██╔══╝██║██╔════╝██║     
██████╔╝██║ ╚███╔╝    ██║   ██║█████╗  ██║     
██╔═══╝ ██║ ██╔██╗    ██║   ██║██╔══╝  ██║     
██║     ██║██╔╝ ██╗   ██║   ██║███████╗███████╗
╚═╝     ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝╚══════╝╚══════╝</pre>

		<div class="text-[#8B949E] mb-4">
			<span class="text-[#3FB950]">✔</span> Select modular components to install:
		</div>

		<!-- Checkbox TUI Mockup -->
		<div class="space-y-1.5 pl-2 mb-6 border-l-2 border-[#30363D]">
			<div class="flex items-center gap-2 text-[#3FB950]">
				<span class="font-bold">[x]</span>
				<span class="text-[#E6EDF3] font-semibold">Agent Stack</span>
				<span class="text-xs text-[#6E7681]">— Multi-agent runtime & CLI orchestration</span>
			</div>
			<div class="flex items-center gap-2 text-[#3FB950]">
				<span class="font-bold">[x]</span>
				<span class="text-[#E6EDF3] font-semibold">Kanban</span>
				<span class="text-xs text-[#6E7681]">— Isolated git worktree board interface</span>
			</div>
			<div class="flex items-center gap-2 text-[#3FB950]">
				<span class="font-bold">[x]</span>
				<span class="text-[#E6EDF3] font-semibold">Plan editor</span>
				<span class="text-xs text-[#6E7681]">— Interactive HTML design & plan refinement</span>
			</div>
			<div class="flex items-center gap-2 text-[#6E7681]">
				<span class="font-bold">[ ]</span>
				<span class="text-[#8B949E]">OmniRoute</span>
				<span class="text-xs text-[#6E7681]">— Multi-provider proxy & token budget optimizer</span>
			</div>
			<div class="flex items-center gap-2 text-[#6E7681]">
				<span class="font-bold">[ ]</span>
				<span class="text-[#8B949E]">Review</span>
				<span class="text-xs text-[#6E7681]">— GitLab MR changes viewer & automated review</span>
			</div>
			<div class="flex items-center gap-2 text-[#6E7681]">
				<span class="font-bold">[ ]</span>
				<span class="text-[#8B949E]">Agent creation</span>
				<span class="text-xs text-[#6E7681]">— Flowise visual agent canvas</span>
			</div>
		</div>

		<!-- One-liner Command Box -->
		<div class="mt-6 pt-4 border-t border-[#30363D]/60">
			<div class="text-xs text-[#8B949E] mb-2 flex items-center justify-between">
				<span>Quick Install One-Liner (Ubuntu &amp; WSL):</span>
				<span class="text-[10px] text-[#6E7681]">Bash</span>
			</div>
			<div class="flex items-center justify-between gap-3 p-3 rounded-lg bg-[#24292E] border border-[#30363D] text-[#E6EDF3]">
				<code class="text-xs sm:text-sm font-mono text-[#4C9AFF] break-all select-all">
					{installCommand}
				</code>
				<button
					type="button"
					class="p-1.5 rounded-md hover:bg-[#2D3339] text-[#8B949E] hover:text-[#E6EDF3] transition-colors shrink-0"
					title="Copy to clipboard"
					aria-label="Copy install command"
				>
					<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
						<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</div>
