---
interface Props {
	id: string;
	title: string;
	description?: string;
	aspectRatio?: string;
	class?: string;
}

const {
	id,
	title,
	description = "Screenshot placeholder — to be captured from live instance in D2",
	aspectRatio = "aspect-16/10",
	class: className = "",
} = Astro.props;
---

<div
	id={id}
	data-screenshot-slot={id}
	class={`w-full rounded-xl border border-[#30363D] bg-[#24292E] overflow-hidden shadow-2xl transition-all duration-200 hover:border-[#444C56] ${className}`}
>
	<!-- Browser window header -->
	<div class="px-4 py-3 bg-[#1F2428] border-b border-[#30363D] flex items-center justify-between">
		<div class="flex items-center gap-2">
			<span class="w-3 h-3 rounded-full bg-[#FF5F56]/80 inline-block"></span>
			<span class="w-3 h-3 rounded-full bg-[#FFBD2E]/80 inline-block"></span>
			<span class="w-3 h-3 rounded-full bg-[#27C93F]/80 inline-block"></span>
		</div>
		<div class="px-3 py-1 rounded bg-[#24292E] border border-[#30363D] text-xs font-mono text-[#8B949E] max-w-[240px] truncate text-center">
			{title}
		</div>
		<div class="w-12"></div>
	</div>

	<!-- Screenshot viewport / placeholder slot -->
	<div class={`w-full ${aspectRatio} bg-gradient-to-b from-[#24292E] to-[#1F2428] flex flex-col items-center justify-center p-6 text-center relative group`}>
		<div class="w-12 h-12 rounded-xl bg-[#2D3339] border border-[#30363D] flex items-center justify-center text-[#0084FF] mb-4 group-hover:scale-105 transition-transform">
			<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
				<circle cx="9" cy="9" r="2"></circle>
				<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
			</svg>
		</div>
		<h4 class="text-sm font-semibold text-[#E6EDF3] mb-1">{title}</h4>
		<p class="text-xs text-[#8B949E] max-w-sm">{description}</p>
		<div class="mt-3 px-2.5 py-1 rounded bg-[#2D3339] border border-[#30363D] text-[10px] font-mono text-[#6E7681]">
			Slot ID: #{id}
		</div>
	</div>
</div>
