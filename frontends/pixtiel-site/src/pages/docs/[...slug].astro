---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/prose.css";

export async function getStaticPaths() {
	const docs = await getCollection("docs");
	const sortedDocs = [...docs].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
	return sortedDocs.map((entry) => ({
		params: { slug: entry.id.replace(/\.mdx?$/, "") },
		props: { entry, allDocs: sortedDocs },
	}));
}

const { entry, allDocs } = Astro.props;
const { Content } = await render(entry);

const currentSlug = entry.id.replace(/\.mdx?$/, "");
const currentIndex = allDocs.findIndex((d) => d.id.replace(/\.mdx?$/, "") === currentSlug);
const prevDoc = currentIndex > 0 ? allDocs[currentIndex - 1] : null;
const nextDoc = currentIndex < allDocs.length - 1 ? allDocs[currentIndex + 1] : null;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
		<div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
			<!-- Left Sidebar Navigation -->
			<aside class="w-full lg:w-64 shrink-0">
				<div class="sticky top-24 space-y-6">
					<div>
						<h5 class="text-xs font-mono uppercase tracking-wider text-[#8B949E] px-3 mb-3 font-semibold">
							Documentation
						</h5>
						<nav class="space-y-1">
							{allDocs.map((doc) => {
								const slug = doc.id.replace(/\.mdx?$/, "");
								const isActive = slug === currentSlug;
								return (
									<a
										href={`/docs/${slug}`}
										class={`flex items-center px-3 py-2 text-sm rounded-lg transition-colors font-medium ${
											isActive
												? "bg-[#0084FF]/15 text-[#0084FF] border border-[#0084FF]/30"
												: "text-[#8B949E] hover:text-[#E6EDF3] hover:bg-[#24292E] border border-transparent"
										}`}
									>
										<span>{doc.data.title}</span>
									</a>
								);
							})}
						</nav>
					</div>

					<div class="p-4 rounded-xl border border-[#30363D] bg-[#24292E]/60 text-xs text-[#8B949E] space-y-2">
						<div class="font-semibold text-[#E6EDF3] flex items-center gap-1.5">
							<svg class="w-4 h-4 text-[#0084FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="12" y1="16" x2="12" y2="12"></line>
								<line x1="12" y1="8" x2="12.01" y2="8"></line>
							</svg>
							<span>Open Source</span>
						</div>
						<p>Need help or want to contribute? Check our repository on GitHub.</p>
						<a
							href="https://github.com/tien0483/PixelCompany"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block text-[#0084FF] hover:text-[#339DFF] font-medium"
						>
							View Repository &rarr;
						</a>
					</div>
				</div>
			</aside>

			<!-- Main Content Area -->
			<main class="min-w-0 flex-1 max-w-4xl">
				<!-- Breadcrumb -->
				<div class="flex items-center gap-2 text-xs font-mono text-[#8B949E] mb-6">
					<a href="/" class="hover:text-[#E6EDF3] transition-colors">Home</a>
					<span>/</span>
					<a href="/docs/getting-started" class="hover:text-[#E6EDF3] transition-colors">Docs</a>
					<span>/</span>
					<span class="text-[#E6EDF3]">{entry.data.title}</span>
				</div>

				<!-- Article Body with Prose Styles -->
				<article class="docs-content text-[#8B949E] leading-relaxed">
					<Content />
				</article>

				<!-- Next / Prev Pagination -->
				<div class="mt-16 pt-8 border-t border-[#30363D] grid grid-cols-1 sm:grid-cols-2 gap-4">
					{prevDoc ? (
						<a
							href={`/docs/${prevDoc.id.replace(/\.mdx?$/, "")}`}
							class="p-4 rounded-xl border border-[#30363D] bg-[#24292E] hover:border-[#444C56] transition-colors group flex flex-col items-start"
						>
							<span class="text-xs text-[#8B949E] group-hover:text-[#0084FF] transition-colors">&larr; Previous</span>
							<span class="text-sm font-semibold text-[#E6EDF3] mt-1">{prevDoc.data.title}</span>
						</a>
					) : <div />}

					{nextDoc ? (
						<a
							href={`/docs/${nextDoc.id.replace(/\.mdx?$/, "")}`}
							class="p-4 rounded-xl border border-[#30363D] bg-[#24292E] hover:border-[#444C56] transition-colors group flex flex-col items-end sm:text-right"
						>
							<span class="text-xs text-[#8B949E] group-hover:text-[#0084FF] transition-colors">Next &rarr;</span>
							<span class="text-sm font-semibold text-[#E6EDF3] mt-1">{nextDoc.data.title}</span>
						</a>
					) : <div />}
				</div>
			</main>
		</div>
	</div>
</BaseLayout>

