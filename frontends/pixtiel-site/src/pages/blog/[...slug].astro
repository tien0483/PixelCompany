---
import { withBase } from "../../lib/base";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/prose.css";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const published = posts
		.filter((p) => !p.data.draft)
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
	return posts.map((entry) => ({
		params: { slug: entry.id.replace(/\.mdx?$/, "") },
		props: { entry, published },
	}));
}

const { entry, published } = Astro.props;
const { Content } = await render(entry);

const slug = entry.id.replace(/\.mdx?$/, "");
const index = published.findIndex((p) => p.id === entry.id);
const newer = index > 0 ? published[index - 1] : null;
const older = index >= 0 && index < published.length - 1 ? published[index + 1] : null;

const dateFormat = new Intl.DateTimeFormat("en", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
		<div class="flex items-center gap-2 text-xs font-mono text-text-secondary mb-8">
			<a href={withBase("/")} class="hover:text-text-primary transition-colors">Home</a>
			<span>/</span>
			<a href={withBase("/blog")} class="hover:text-text-primary transition-colors">Blog</a>
		</div>

		<header class="pb-8 border-b border-border">
			<div class="flex flex-wrap items-center gap-3 text-xs font-mono text-text-secondary">
				<time datetime={entry.data.date.toISOString()}>{dateFormat.format(entry.data.date)}</time>
				<span>·</span>
				<span>{entry.data.author}</span>
				{
					entry.data.tags.map((tag) => (
						<span class="px-2 py-0.5 rounded border border-border bg-surface-1">{tag}</span>
					))
				}
				{entry.data.draft ? <span class="px-2 py-0.5 rounded bg-accent/15 text-accent">draft</span> : null}
			</div>
			<h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-text-primary leading-tight">
				{entry.data.title}
			</h1>
			<p class="mt-4 text-base sm:text-lg text-text-secondary leading-relaxed">{entry.data.description}</p>
		</header>

		<div class="docs-content text-text-secondary leading-relaxed mt-10">
			<Content />
		</div>

		<div class="mt-16 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4">
			{
				older ? (
					<a
						href={withBase(`/blog/${older.id.replace(/\.mdx?$/, "")}`)}
						class="p-4 rounded-xl border border-border bg-surface-1 hover:border-border-bright transition-colors group flex flex-col items-start"
					>
						<span class="text-xs text-text-secondary group-hover:text-accent transition-colors">&larr; Older</span>
						<span class="text-sm font-semibold text-text-primary mt-1">{older.data.title}</span>
					</a>
				) : (
					<div />
				)
			}
			{
				newer ? (
					<a
						href={withBase(`/blog/${newer.id.replace(/\.mdx?$/, "")}`)}
						class="p-4 rounded-xl border border-border bg-surface-1 hover:border-border-bright transition-colors group flex flex-col items-end sm:text-right"
					>
						<span class="text-xs text-text-secondary group-hover:text-accent transition-colors">Newer &rarr;</span>
						<span class="text-sm font-semibold text-text-primary mt-1">{newer.data.title}</span>
					</a>
				) : (
					<div />
				)
			}
		</div>

		<div class="mt-10 p-6 rounded-2xl border border-border bg-surface-1">
			<h2 class="text-lg font-semibold text-text-primary">Run it yourself</h2>
			<p class="mt-2 text-sm text-text-secondary">
				One command installs PIXTiel on Ubuntu or WSL2 and offers to start it.
			</p>
			<pre class="mt-4 px-4 py-3 rounded-lg border border-border bg-surface-0 text-xs font-mono text-text-primary overflow-x-auto"><code>curl -fsSL https://raw.githubusercontent.com/tien0483/PixelCompany/main/install.sh | bash</code></pre>
			<a href={withBase(`/docs/getting-started`)} class="mt-4 inline-block text-sm font-semibold text-accent hover:text-[#339DFF]">
				Getting started &rarr;
			</a>
		</div>
	</article>
</BaseLayout>
