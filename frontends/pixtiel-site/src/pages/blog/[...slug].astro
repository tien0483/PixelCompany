---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/prose.css";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const published = posts
		.filter((p) => !p.data.draft)
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
	return posts.map((entry) => ({
		params: { slug: entry.id.replace(/\.mdx?$/, "") },
		props: { entry, published },
	}));
}

const { entry, published } = Astro.props;
const { Content } = await render(entry);

const slug = entry.id.replace(/\.mdx?$/, "");
const index = published.findIndex((p) => p.id === entry.id);
const newer = index > 0 ? published[index - 1] : null;
const older = index >= 0 && index < published.length - 1 ? published[index + 1] : null;

const dateFormat = new Intl.DateTimeFormat("en", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
		<div class="flex items-center gap-2 text-xs font-mono text-[#8B949E] mb-8">
			<a href="/" class="hover:text-[#E6EDF3] transition-colors">Home</a>
			<span>/</span>
			<a href="/blog" class="hover:text-[#E6EDF3] transition-colors">Blog</a>
		</div>

		<header class="pb-8 border-b border-[#30363D]">
			<div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[#8B949E]">
				<time datetime={entry.data.date.toISOString()}>{dateFormat.format(entry.data.date)}</time>
				<span>·</span>
				<span>{entry.data.author}</span>
				{
					entry.data.tags.map((tag) => (
						<span class="px-2 py-0.5 rounded border border-[#30363D] bg-[#24292E]">{tag}</span>
					))
				}
				{entry.data.draft ? <span class="px-2 py-0.5 rounded bg-[#0084FF]/15 text-[#0084FF]">draft</span> : null}
			</div>
			<h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-[#E6EDF3] leading-tight">
				{entry.data.title}
			</h1>
			<p class="mt-4 text-base sm:text-lg text-[#8B949E] leading-relaxed">{entry.data.description}</p>
		</header>

		<div class="docs-content text-[#8B949E] leading-relaxed mt-10">
			<Content />
		</div>

		<div class="mt-16 pt-8 border-t border-[#30363D] grid grid-cols-1 sm:grid-cols-2 gap-4">
			{
				older ? (
					<a
						href={`/blog/${older.id.replace(/\.mdx?$/, "")}`}
						class="p-4 rounded-xl border border-[#30363D] bg-[#24292E] hover:border-[#444C56] transition-colors group flex flex-col items-start"
					>
						<span class="text-xs text-[#8B949E] group-hover:text-[#0084FF] transition-colors">&larr; Older</span>
						<span class="text-sm font-semibold text-[#E6EDF3] mt-1">{older.data.title}</span>
					</a>
				) : (
					<div />
				)
			}
			{
				newer ? (
					<a
						href={`/blog/${newer.id.replace(/\.mdx?$/, "")}`}
						class="p-4 rounded-xl border border-[#30363D] bg-[#24292E] hover:border-[#444C56] transition-colors group flex flex-col items-end sm:text-right"
					>
						<span class="text-xs text-[#8B949E] group-hover:text-[#0084FF] transition-colors">Newer &rarr;</span>
						<span class="text-sm font-semibold text-[#E6EDF3] mt-1">{newer.data.title}</span>
					</a>
				) : (
					<div />
				)
			}
		</div>

		<div class="mt-10 p-6 rounded-2xl border border-[#30363D] bg-[#24292E]/60">
			<h2 class="text-lg font-semibold text-[#E6EDF3]">Run it yourself</h2>
			<p class="mt-2 text-sm text-[#8B949E]">
				One command installs PIXTiel on Ubuntu or WSL2 and offers to start it.
			</p>
			<pre class="mt-4 px-4 py-3 rounded-lg border border-[#30363D] bg-[#1F2428] text-xs font-mono text-[#E6EDF3] overflow-x-auto"><code>curl -fsSL https://raw.githubusercontent.com/tien0483/PixelCompany/main/install.sh | bash</code></pre>
			<a href={`/docs/getting-started`} class="mt-4 inline-block text-sm font-semibold text-[#0084FF] hover:text-[#339DFF]">
				Getting started &rarr;
			</a>
		</div>
	</article>
</BaseLayout>
