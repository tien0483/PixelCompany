---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat("en", { year: "numeric", month: "long", day: "numeric" });
const [featured, ...rest] = posts;
---

<BaseLayout
	title="Blog"
	description="Engineering notes from building PIXTiel: worktree isolation, seat management, token cost and the traps found along the way."
>
	<section class="border-b border-[#30363D]">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
			<p class="text-xs font-mono uppercase tracking-widest text-[#0084FF] mb-4">Blog</p>
			<h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#E6EDF3]">Engineering notes</h1>
			<p class="mt-5 text-base sm:text-lg text-[#8B949E] max-w-2xl leading-relaxed">
				How PIXTiel is built and why it is built that way — the decisions, the measurements, and the
				traps that only show up once agents run in parallel on real repositories.
			</p>
			<a
				href="/rss.xml"
				class="mt-6 inline-flex items-center gap-1.5 text-xs font-mono text-[#8B949E] hover:text-[#E6EDF3] transition-colors"
			>
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
				RSS
			</a>
		</div>
	</section>

	<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
		{
			posts.length === 0 ? (
				<p class="text-sm text-[#8B949E]">No posts yet.</p>
			) : (
				<div class="space-y-10">
					{featured ? (
						<a
							href={`/blog/${featured.id.replace(/\.mdx?$/, "")}`}
							class="block group rounded-2xl border border-[#30363D] bg-[#24292E]/60 p-6 sm:p-8 hover:border-[#444C56] transition-colors"
						>
							<div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[#8B949E]">
								<time datetime={featured.data.date.toISOString()}>
									{dateFormat.format(featured.data.date)}
								</time>
								{featured.data.tags.map((tag) => (
									<span class="px-2 py-0.5 rounded border border-[#30363D] bg-[#1F2428]">{tag}</span>
								))}
							</div>
							<h2 class="mt-4 text-2xl sm:text-3xl font-bold tracking-tight text-[#E6EDF3] group-hover:text-white transition-colors">
								{featured.data.title}
							</h2>
							<p class="mt-3 text-sm sm:text-base text-[#8B949E] leading-relaxed">
								{featured.data.description}
							</p>
							<span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[#0084FF]">
								Read the post
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<line x1="5" y1="12" x2="19" y2="12"></line>
									<polyline points="12 5 19 12 12 19"></polyline>
								</svg>
							</span>
						</a>
					) : null}

					{rest.length > 0 ? (
						<div class="divide-y divide-[#30363D] border-t border-[#30363D]">
							{rest.map((post) => (
								<a
									href={`/blog/${post.id.replace(/\.mdx?$/, "")}`}
									class="block group py-7 hover:bg-[#24292E]/30 transition-colors -mx-4 px-4 rounded-lg"
								>
									<div class="flex flex-wrap items-center gap-3 text-xs font-mono text-[#8B949E]">
										<time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
										{post.data.tags.map((tag) => (
											<span class="px-2 py-0.5 rounded border border-[#30363D] bg-[#1F2428]">{tag}</span>
										))}
									</div>
									<h3 class="mt-2.5 text-lg sm:text-xl font-semibold text-[#E6EDF3] group-hover:text-white transition-colors">
										{post.data.title}
									</h3>
									<p class="mt-2 text-sm text-[#8B949E] leading-relaxed">{post.data.description}</p>
								</a>
							))}
						</div>
					) : null}
				</div>
			)
		}
	</div>
</BaseLayout>
