---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Autonomous Agent Workspace">
	<!-- D1 sections land here -->
	<section class="py-24 px-4 sm:px-6 max-w-6xl mx-auto text-center flex flex-col items-center justify-center min-h-[60vh]">
		<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-[#24292E] border border-[#30363D] text-[#8B949E] mb-6">
			<span class="w-2 h-2 rounded-full bg-[#0084FF] animate-pulse"></span>
			<span>Next-Generation Autonomous Workspace</span>
		</div>
		<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-[#E6EDF3] max-w-3xl leading-tight">
			Orchestrate Autonomous Agents in a Unified Workspace
		</h1>
		<p class="mt-6 text-lg sm:text-xl text-[#8B949E] max-w-2xl">
			PIXTiel coordinates multiple autonomous agents across codebases, tickets, and terminal sessions with native developer tools.
		</p>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
			<a
				href="#install"
				class="px-6 py-3 rounded-lg bg-[#0084FF] hover:bg-[#339DFF] text-white font-semibold shadow-md transition-colors"
			>
				Get Started
			</a>
			<a
				href="/docs/getting-started"
				class="px-6 py-3 rounded-lg bg-[#24292E] hover:bg-[#2D3339] border border-[#30363D] text-[#E6EDF3] font-semibold transition-colors"
			>
				Documentation
			</a>
		</div>
	</section>
</BaseLayout>
