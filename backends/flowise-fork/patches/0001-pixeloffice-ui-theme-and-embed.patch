diff --git a/packages/ui/src/pixeloffice/EmbedAutoLogin.jsx b/packages/ui/src/pixeloffice/EmbedAutoLogin.jsx
new file mode 100644
index 0000000..b7043f0
--- /dev/null
+++ b/packages/ui/src/pixeloffice/EmbedAutoLogin.jsx
@@ -0,0 +1,64 @@
+import PropTypes from 'prop-types'
+import { useEffect, useState } from 'react'
+import { useSelector } from 'react-redux'
+
+import { store } from '@/store'
+import { loginSuccess } from '@/store/reducers/authSlice'
+
+import { isEmbedded } from './embed'
+
+const CREDENTIAL_URL = '/api/v1/pixeloffice-embed/credential'
+const LOGIN_URL = '/api/v1/auth/login'
+
+/**
+ * Signs the framed studio in with the local account PixelOffice's runtime seeded, so the
+ * Agents tab never shows a login screen.
+ *
+ * Upstream's account system is kept as shipped (its schema and migrations live in the
+ * commercially-licensed `enterprise/` tree, so removing it would mean forking the schema).
+ * The credential is served only to loopback callers by
+ * `packages/server/src/pixeloffice/embed-credential-route.ts` and only when
+ * `PIXELOFFICE_EMBED=1` — outside that, this component is inert and the normal login runs.
+ */
+export const EmbedAutoLogin = ({ children }) => {
+    const currentUser = useSelector((state) => state.auth.user)
+    const [attempted, setAttempted] = useState(false)
+
+    useEffect(() => {
+        if (!isEmbedded() || currentUser || attempted) return
+        let cancelled = false
+        const signIn = async () => {
+            try {
+                const credentialResponse = await fetch(CREDENTIAL_URL, { credentials: 'include' })
+                if (!credentialResponse.ok) return
+                const credential = await credentialResponse.json()
+                const loginResponse = await fetch(LOGIN_URL, {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    credentials: 'include',
+                    body: JSON.stringify({ email: credential.email, password: credential.password })
+                })
+                if (!loginResponse.ok || cancelled) return
+                store.dispatch(loginSuccess(await loginResponse.json()))
+            } catch (e) {
+                // Leave the normal login screen in place rather than blocking the canvas.
+            } finally {
+                // One attempt only: a retry loop against a studio whose account drifted would
+                // hammer the login route on every render.
+                if (!cancelled) setAttempted(true)
+            }
+        }
+        void signIn()
+        return () => {
+            cancelled = true
+        }
+    }, [currentUser, attempted])
+
+    return children
+}
+
+EmbedAutoLogin.propTypes = {
+    children: PropTypes.node
+}
+
+export default EmbedAutoLogin
diff --git a/packages/ui/src/pixeloffice/embed.js b/packages/ui/src/pixeloffice/embed.js
new file mode 100644
index 0000000..2f80e57
--- /dev/null
+++ b/packages/ui/src/pixeloffice/embed.js
@@ -0,0 +1,41 @@
+// PixelOffice embed mode. The studio is framed by PixelOffice's Agents tab, which passes
+// `?embed=1` on the first load. Everything here is additive: without the flag the studio
+// behaves exactly as upstream, so it stays debuggable on its own port.
+
+const EMBED_QUERY_KEY = 'embed'
+const EMBED_SESSION_KEY = 'pixeloffice.embed'
+
+/**
+ * The studio uses BrowserRouter, so any internal navigation drops the query string — the
+ * flag is therefore latched into sessionStorage on first load and read from there
+ * afterwards. sessionStorage (not localStorage) so opening the studio directly in a browser
+ * tab is never stuck in embed mode.
+ */
+export const isEmbedded = () => {
+    try {
+        const fromQuery = new URLSearchParams(window.location.search).get(EMBED_QUERY_KEY)
+        if (fromQuery === '1') {
+            window.sessionStorage.setItem(EMBED_SESSION_KEY, '1')
+            return true
+        }
+        return window.sessionStorage.getItem(EMBED_SESSION_KEY) === '1'
+    } catch (e) {
+        return false
+    }
+}
+
+/**
+ * PixelOffice is dark-only, so a light-mode studio inside its frame reads as a broken embed.
+ * This runs as an import side effect *before* customizationReducer reads the same key for its
+ * initial state, which is why `index.jsx` imports this module first.
+ */
+export const forceDarkModeWhenEmbedded = () => {
+    if (!isEmbedded()) return
+    try {
+        window.localStorage.setItem('isDarkMode', 'true')
+    } catch (e) {
+        // Private-mode browsers: the theme falls back to upstream's default, nothing breaks.
+    }
+}
+
+forceDarkModeWhenEmbedded()
