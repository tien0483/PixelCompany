+++ b/packages/server/src/pixeloffice/embed-credential-route.ts
@@ -0,0 +1,62 @@
+import express, { Request, Response } from 'express'
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+
+/**
+ * PixelOffice embed support.
+ *
+ * PixelOffice's runtime seeds one local studio account and writes its credential (0600) into
+ * the studio's own data dir. The framed UI reads it from here and performs the normal login,
+ * so the Agents tab never shows a login screen. Upstream's account system is untouched.
+ *
+ * Three conditions gate this route, and all three must hold:
+ *   1. `PIXELOFFICE_EMBED=1` — off by default, so a stock deployment never exposes it.
+ *   2. The request must arrive from loopback.
+ *   3. The credential file must exist where the runtime wrote it.
+ *
+ * The credential is not a security boundary — the studio binds to loopback and only the
+ * PixelOffice origin may call it (`CORS_ORIGINS`) or frame it (`IFRAME_ORIGINS`). Do not
+ * enable this on a host reachable from anywhere else.
+ */
+const CREDENTIAL_FILE_NAME = 'embed-credential.json'
+const LOOPBACK_ADDRESSES = new Set(['127.0.0.1', '::1', '::ffff:127.0.0.1'])
+
+const isEmbedEnabled = (): boolean => process.env.PIXELOFFICE_EMBED === '1'
+
+const isLoopbackRequest = (req: Request): boolean => {
+    const address = req.socket.remoteAddress ?? ''
+    return LOOPBACK_ADDRESSES.has(address)
+}
+
+const resolveCredentialPath = (): string => {
+    // The runtime points SECRETKEY_PATH at the same `.flowise` dir it wrote the file into;
+    // DATABASE_PATH is the fallback for a hand-run studio that only set that one.
+    const dir = process.env.SECRETKEY_PATH?.trim() || process.env.DATABASE_PATH?.trim()
+    return dir ? join(dir, CREDENTIAL_FILE_NAME) : ''
+}
+
+const router = express.Router()
+
+router.get('/credential', async (req: Request, res: Response) => {
+    if (!isEmbedEnabled() || !isLoopbackRequest(req)) {
+        res.status(404).json({ message: 'Not found' })
+        return
+    }
+    const path = resolveCredentialPath()
+    if (!path) {
+        res.status(503).json({ message: 'No credential directory configured' })
+        return
+    }
+    try {
+        const parsed = JSON.parse(await readFile(path, 'utf8'))
+        if (typeof parsed?.email !== 'string' || typeof parsed?.password !== 'string') {
+            res.status(503).json({ message: 'Embed credential is malformed' })
+            return
+        }
+        res.json({ email: parsed.email, password: parsed.password })
+    } catch (error) {
+        res.status(503).json({ message: 'Embed credential is not available yet' })
+    }
+})
+
+export default router
