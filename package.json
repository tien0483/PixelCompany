{
  "name": "pixel-office",
  "private": true,
  "description": "Pixel Office unified stack — React UI + Node runtime + Jacked Python",
  "workspaces": [
    "frontends/pixel_office",
    "backends/runtime"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node scripts/start-stack.mjs",
    "dev": "node scripts/start-stack.mjs",
    "restart": "node scripts/start-stack.mjs --restart",
    "solo": "node scripts/solo.mjs",
    "test:web": "npm --prefix frontends/pixel_office run test",
    "test:runtime": "npm --prefix backends/runtime run test:fast",
    "test:e2e": "npm --prefix frontends/pixel_office run e2e",
    "test:e2e:solo": "npm --prefix frontends/pixel_office run e2e:solo"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
