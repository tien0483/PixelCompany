# Dependencies
node_modules/

# WARP artifacts
.warp/
.cocoindex_code/
graphify-out/

# Build output
frontends/pixel_office/dist/
backends/html_anything/next/.next/
scripts/windows/dist/

# Python
__pycache__/
*.pyc

# Windows offline installer staging (rebuilt by installer/build-installer.mjs)
scripts/windows/installer/.cache/
scripts/windows/installer/stage/

# Agent stack payload (backends/agent_stack)
#
# Only the thin control layer is tracked — server.py, activate-stack.sh,
# install.sh, pyproject.toml/uv.lock, package.json/package-lock.json. Everything
# below is either a third-party checkout, a build product, a downloaded binary or
# machine state, and none of it belongs in git.
#
# Being ignored is also load-bearing, not incidental: the runtime symlinks every
# git-ignored path into each task worktree (syncIgnoredPathsIntoWorktree in
# backends/runtime/src/workspace/task-worktree.ts), so listing these here is what
# gives a task agent `rtk` on the same relative path and one shared flags file
# instead of 2 GB copied per worktree.
backends/agent_stack/.venv/
backends/agent_stack/venv.stale-delete-me/
backends/agent_stack/bin/
backends/agent_stack/logs/
backends/agent_stack/ccr-home/
backends/agent_stack/src-understand-anything/
backends/agent_stack/src-claude-devtools/
backends/agent_stack/skills/caveman
backends/agent_stack/stack-flags.json
backends/agent_stack/*.bak

# Stack-provided skills, symlinked into .claude/skills by
# scripts/link-stack-skills.mjs. They are machine-local links, so they cannot be
# committed — and being ignored is what makes the runtime mirror them into every
# task worktree, which is the only reason a task agent can resolve /understand.
# Repo-owned skills (.claude/skills/pixeloffice-*) stay tracked.
.claude/skills/caveman
.claude/skills/understand
.claude/skills/understand-*

# Understand-Anything knowledge graph (generated by /understand). Ignored, so the
# runtime mirrors it into task worktrees — one graph shared by every task, which
# matches UA's own behaviour of redirecting worktree output to the main repo root.
.ua/
.understand-anything/

# Generated by scripts/build-plan-editor-standalone.mjs.
/plan-editor-standalone/
/dist/plan-editor-standalone*.zip
/dist/plan-editor-standalone*.tar.gz

# Generated by scripts/build-review-standalone.mjs.
/review-standalone/
/dist/review-standalone*.zip
/dist/review-standalone*.tar.gz

# Temporary / scratch workspaces & plans (stored globally in Claude / agent / Gemini)
_workspace/
.plan/
*.log
_tsc*.txt

